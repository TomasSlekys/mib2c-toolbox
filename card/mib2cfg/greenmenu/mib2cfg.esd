###########################################################################################
#
# MIB2 Configurator: install edited skin files (skin0: images.mcf, Data/ zone files; theme skins skin1..skin6:
# images.mcf, images.res) and startup screens (startanim/startup_N.boot), or put the originals back
# Installed by mib2cfg/mib2cfg.sh (mode menu) from an SD card or USB stick.
#
# Main -> MIB2 Configurator
#
###########################################################################################
# mib2cfg-version 0.4.0
screen MIB2_Configurator Main

keyValue
    value   String sys 0x00000000 0
    label   "MIB2 Configurator: edited files from mib2cfg/skin0..skin6 and mib2cfg/startanim on the card"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "The unit's original files are kept in mib2cfg/backup. Logs: mib2cfg/logs"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Wait for FINISHED. The '... and reboot' buttons restart only after a clean run."
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "__________________________________________________________________"
    poll    0

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_check.sh"
    label   "Check (read only)"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_install.sh"
    label   "Install edited files"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_installreboot.sh"
    label   "Install edited files and reboot"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_restore.sh"
    label   "Restore original files"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_restorereboot.sh"
    label   "Restore original files and reboot"

keyValue
    value   String sys 0x00000000 0
    label   "__________________________________________________________________"
    poll    0

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_startup.sh"
    label   "Install startup screens"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_startupreboot.sh"
    label   "Install startup screens and reboot"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_startuprestore.sh"
    label   "Restore startup screens"

keyValue
    value   String sys 0x00000000 0
    label   "__________________________________________________________________"
    poll    0

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_reboot.sh"
    label   "Reboot unit"

keyValue
    value   String sys 0x00000000 0
    label   "__________________________________________________________________"
    poll    0

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_updatemenu.sh"
    label   "Update this menu from the card"

script
    value   sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/mib2cfg_removemenu.sh"
    label   "Remove this menu from the unit"
